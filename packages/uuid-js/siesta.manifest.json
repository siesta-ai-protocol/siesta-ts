{
  "siesta": "1.0",
  "library": "siesta-uuid-js",
  "version": "0.1.0",
  "description": "RFC UUID generation",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "UuidJsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
