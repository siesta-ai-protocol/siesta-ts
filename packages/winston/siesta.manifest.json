{
  "siesta": "1.0",
  "library": "siesta-winston",
  "version": "0.1.0",
  "description": "Logging library",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "WinstonAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "create": {
      "returns": "Logger",
      "description": "Create a Logger via winston",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  "types": {
    "Logger": {
      "methods": {
        "info": {
          "returns": "Logger",
          "params": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "error": {
          "returns": "Logger",
          "params": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "debug": {
          "returns": "Logger",
          "params": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        }
      }
    }
  }
}
