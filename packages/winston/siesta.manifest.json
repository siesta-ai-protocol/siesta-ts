{
  "siesta": "1.0",
  "library": "siesta-winston",
  "version": "0.2.0",
  "description": "Logging library (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "WinstonAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Logger",
      "description": "Create a Logger via winston",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "parse": {
      "returns": "Logger",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      }
    }
  },
  "types": {
    "Logger": {
      "methods": {
        "info": {
          "returns": "Logger",
          "params": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "error": {
          "returns": "Logger",
          "params": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "debug": {
          "returns": "Logger",
          "params": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "reset": {
          "returns": "Logger",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    }
  }
}
