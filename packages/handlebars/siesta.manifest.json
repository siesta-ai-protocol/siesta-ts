{
  "siesta": "1.0",
  "library": "siesta-handlebars",
  "version": "0.1.0",
  "description": "Template engine",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "HandlebarsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "create": {
      "returns": "Handle",
      "description": "Create a Handle via handlebars",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    }
  },
  "types": {
    "Handle": {
      "methods": {
        "run": {
          "returns": "Handle",
          "params": {
            "type": "object",
            "properties": {
              "input": {}
            },
            "required": []
          }
        },
        "result": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    }
  }
}
