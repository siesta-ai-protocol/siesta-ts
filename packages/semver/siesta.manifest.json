{
  "siesta": "1.0",
  "library": "siesta-semver",
  "version": "0.1.0",
  "description": "Semantic versioning",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "SemverAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "create": {
      "returns": "Handle",
      "description": "Create a Handle via semver",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Handle": {
      "methods": {
        "run": {
          "returns": "Handle",
          "params": {
            "type": "object",
            "properties": {
              "input": {}
            },
            "required": []
          },
          "since": "1.0.0"
        },
        "result": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "semver",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
