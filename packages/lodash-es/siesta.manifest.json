{
  "siesta": "1.0",
  "library": "siesta-lodash-es",
  "version": "0.1.0",
  "description": "Utility library (ES modules)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "LodashEsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "create": {
      "returns": "Collection",
      "description": "Create a Collection via lodash-es",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Collection": {
      "methods": {
        "push": {
          "returns": "Collection",
          "params": {
            "type": "object",
            "properties": {
              "item": {}
            },
            "required": [
              "item"
            ]
          },
          "since": "1.0.0"
        },
        "count": {
          "returns": "integer",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "toArray": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "description": "JSON-encoded array snapshot",
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "lodash-es",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
