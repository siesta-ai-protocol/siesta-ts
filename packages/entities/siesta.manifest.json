{
  "siesta": "1.0",
  "library": "siesta-entities",
  "version": "0.2.0",
  "description": "HTML entity encode/decode (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "EntitiesAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Text",
      "description": "Create a Text via entities",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          }
        },
        "required": [
          "input"
        ]
      }
    },
    "parse": {
      "returns": "Text",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      }
    }
  },
  "types": {
    "Text": {
      "methods": {
        "upper": {
          "returns": "Text",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "lower": {
          "returns": "Text",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "length": {
          "returns": "integer",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "toString": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "reset": {
          "returns": "Text",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    }
  }
}
