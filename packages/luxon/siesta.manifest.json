{
  "siesta": "1.0",
  "library": "siesta-luxon",
  "version": "0.2.0",
  "description": "DateTime library (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "LuxonAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "now": {
      "returns": "DateTime",
      "description": "Create a DateTime via luxon",
      "params": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          }
        },
        "required": []
      },
      "since": "1.0.0"
    },
    "parse": {
      "returns": "DateTime",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "DateTime": {
      "methods": {
        "addDays": {
          "returns": "DateTime",
          "params": {
            "type": "object",
            "properties": {
              "days": {
                "type": "integer"
              }
            },
            "required": [
              "days"
            ]
          },
          "since": "1.0.0"
        },
        "format": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "since": "1.0.0"
        },
        "toIso": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "reset": {
          "returns": "DateTime",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "luxon",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
