{
  "siesta": "1.0",
  "library": "siesta-highlight-js",
  "version": "0.2.0",
  "description": "Syntax highlighting (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "HighlightJsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Handle",
      "description": "Create a Handle via highlight.js",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "parse": {
      "returns": "Handle",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      }
    }
  },
  "types": {
    "Handle": {
      "methods": {
        "run": {
          "returns": "Handle",
          "params": {
            "type": "object",
            "properties": {
              "input": {}
            },
            "required": []
          }
        },
        "result": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "reset": {
          "returns": "Handle",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    }
  }
}
