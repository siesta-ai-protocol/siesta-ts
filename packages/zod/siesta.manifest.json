{
  "siesta": "1.0",
  "library": "siesta-zod",
  "version": "0.1.0",
  "description": "TypeScript-first schema validation",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "ZodAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "create": {
      "returns": "Validator",
      "description": "Create a Validator via zod",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Validator": {
      "methods": {
        "validate": {
          "returns": "boolean",
          "params": {
            "type": "object",
            "properties": {
              "value": {}
            },
            "required": [
              "value"
            ]
          },
          "since": "1.0.0"
        },
        "assert": {
          "returns": "Validator",
          "params": {
            "type": "object",
            "properties": {
              "value": {}
            },
            "required": [
              "value"
            ]
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "zod",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
