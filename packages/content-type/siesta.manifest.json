{
  "siesta": "1.0",
  "library": "siesta-content-type",
  "version": "0.2.0",
  "description": "Content-Type parser (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "ContentTypeAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Client",
      "description": "Create a Client via content-type",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "since": "1.0.0"
    },
    "parse": {
      "returns": "Client",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Client": {
      "methods": {
        "get": {
          "returns": "Response",
          "params": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          },
          "since": "1.0.0"
        },
        "post": {
          "returns": "Response",
          "params": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "body": {
                "type": "object"
              }
            },
            "required": [
              "url"
            ]
          },
          "since": "1.0.0"
        },
        "withHeader": {
          "returns": "Client",
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "since": "1.0.0"
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "reset": {
          "returns": "Client",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    },
    "Response": {
      "methods": {
        "status": {
          "returns": "integer",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "body": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "content-type",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
