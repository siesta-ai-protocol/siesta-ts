{
  "siesta": "1.0",
  "library": "siesta-remark",
  "version": "0.2.0",
  "description": "Markdown processor (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "RemarkAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "parse": {
      "returns": "Document",
      "description": "Create a Document via remark",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          }
        },
        "required": [
          "input"
        ]
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Document": {
      "methods": {
        "toHtml": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "toText": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "reset": {
          "returns": "Document",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "remark",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
