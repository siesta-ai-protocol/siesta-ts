{
  "siesta": "1.0",
  "library": "siesta-carbon-date",
  "version": "1.0.0",
  "description": "Date manipulation via date-fns",
  "package": {
    "name": "date-fns",
    "version": "4.0.0",
    "range": "^4.0"
  },
  "adapter": {
    "class": "DateFnsAdapter"
  },
  "factories": {
    "now": {
      "returns": "DateTime",
      "since": "2.0.0",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "parse": {
      "returns": "DateTime",
      "since": "2.0.0",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          }
        },
        "required": [
          "input"
        ]
      }
    }
  },
  "types": {
    "DateTime": {
      "methods": {
        "addWeeks": {
          "returns": "DateTime",
          "since": "2.0.0",
          "params": {
            "type": "object",
            "properties": {
              "weeks": {
                "type": "integer"
              }
            },
            "required": [
              "weeks"
            ]
          }
        },
        "format": {
          "returns": "string",
          "since": "2.0.0",
          "params": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ]
          }
        }
      }
    }
  }
}
