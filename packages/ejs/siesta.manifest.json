{
  "siesta": "1.0",
  "library": "siesta-ejs",
  "version": "0.2.0",
  "description": "Embedded JS templates (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "EjsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Handle",
      "description": "Create a Handle via ejs",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "since": "1.0.0"
    },
    "parse": {
      "returns": "Handle",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Handle": {
      "methods": {
        "run": {
          "returns": "Handle",
          "params": {
            "type": "object",
            "properties": {
              "input": {}
            },
            "required": []
          },
          "since": "1.0.0"
        },
        "result": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "reset": {
          "returns": "Handle",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "ejs",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
