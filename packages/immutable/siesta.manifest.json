{
  "siesta": "1.0",
  "library": "siesta-immutable",
  "version": "0.2.0",
  "description": "Immutable collections (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "ImmutableAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Collection",
      "description": "Create a Collection via immutable",
      "params": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "since": "1.0.0"
    },
    "parse": {
      "returns": "Collection",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Collection": {
      "methods": {
        "push": {
          "returns": "Collection",
          "params": {
            "type": "object",
            "properties": {
              "item": {}
            },
            "required": [
              "item"
            ]
          },
          "since": "1.0.0"
        },
        "count": {
          "returns": "integer",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "toArray": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "description": "JSON-encoded array snapshot",
          "since": "1.0.0"
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "reset": {
          "returns": "Collection",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "immutable",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
