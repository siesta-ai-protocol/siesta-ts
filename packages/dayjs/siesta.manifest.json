{
  "siesta": "1.0",
  "library": "siesta-dayjs",
  "version": "0.1.0",
  "description": "Minimalist date library",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "DayjsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "now": {
      "returns": "DateTime",
      "description": "Create a DateTime via dayjs",
      "params": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string"
          }
        },
        "required": []
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "DateTime": {
      "methods": {
        "addDays": {
          "returns": "DateTime",
          "params": {
            "type": "object",
            "properties": {
              "days": {
                "type": "integer"
              }
            },
            "required": [
              "days"
            ]
          },
          "since": "1.0.0"
        },
        "format": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "since": "1.0.0"
        },
        "toIso": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "dayjs",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
