{
  "siesta": "1.0",
  "library": "siesta-decimal-js",
  "version": "0.2.0",
  "description": "Arbitrary-precision decimals (deep experimental surface)",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "DecimalJsAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "Strict validation / parsing"
    }
  },
  "factories": {
    "create": {
      "returns": "Money",
      "description": "Create a Money via decimal.js",
      "params": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "amount"
        ]
      }
    },
    "parse": {
      "returns": "Money",
      "description": "Parse / build from input",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Raw input"
          }
        },
        "required": [
          "input"
        ]
      }
    }
  },
  "types": {
    "Money": {
      "methods": {
        "add": {
          "returns": "Money",
          "params": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number"
              }
            },
            "required": [
              "amount"
            ]
          }
        },
        "format": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "getAmount": {
          "returns": "number",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "inspect": {
          "returns": "string",
          "description": "Debug snapshot string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "reset": {
          "returns": "Money",
          "description": "Reset to initial state",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          }
        }
      }
    }
  }
}
