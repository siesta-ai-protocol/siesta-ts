{
  "siesta": "1.0",
  "library": "siesta-cheerio",
  "version": "0.1.0",
  "description": "Server-side jQuery-like DOM",
  "minSiestaVersion": "1.0",
  "adapter": {
    "class": "CheerioAdapter"
  },
  "config": {
    "locale": {
      "type": "string",
      "default": "en",
      "description": "Default locale"
    }
  },
  "factories": {
    "load": {
      "returns": "Document",
      "description": "Create a Document via cheerio",
      "params": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          }
        },
        "required": [
          "input"
        ]
      },
      "since": "1.0.0"
    }
  },
  "types": {
    "Document": {
      "methods": {
        "query": {
          "returns": "Document",
          "params": {
            "type": "object",
            "properties": {
              "selector": {
                "type": "string"
              }
            },
            "required": [
              "selector"
            ]
          },
          "since": "1.0.0"
        },
        "text": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        },
        "html": {
          "returns": "string",
          "params": {
            "type": "object",
            "properties": {},
            "required": []
          },
          "since": "1.0.0"
        }
      }
    }
  },
  "package": {
    "name": "cheerio",
    "version": "1.0.0",
    "range": "^1.0 || ^2.0 || ^3.0 || ^4.0"
  }
}
